# Configuration for the-tyler-update.sh (installed at /opt/thetyler/update.env).
# Referenced by the-tyler-update.service via EnvironmentFile.

# GitHub repository to pull releases from.
GITHUB_REPO=endzyme/thetyler

# Directory where the managed binaries (and this script) live.
INSTALL_DIR=/opt/thetyler/bin

# Space-separated "binary:unit" pairs this host should keep updated. The updater
# swaps each binary and restarts its unit only when the binary actually changes.
#
#   - Single-box setup (web app + firewall client together): keep both pairs.
#   - Firewall-client-only host (web app hosted offsite on a platform that
#     deploys itself): drop the "thetyler:thetyler.service" pair, e.g.
#       COMPONENTS=nftables-sync-client:thetyler-nftables.service
COMPONENTS=thetyler:thetyler.service nftables-sync-client:thetyler-nftables.service

# Path to this updater script, so it can refresh itself from each release.
# SCRIPT_PATH=/opt/thetyler/bin/the-tyler-update.sh

# Optional: a GitHub token raises the API rate limit (60/hr unauthenticated is
# plenty for a 15-minute poll, so this is usually unnecessary).
# GITHUB_TOKEN=ghp_...
