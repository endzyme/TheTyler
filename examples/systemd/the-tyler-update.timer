[Unit]
Description=Run The Tyler auto-updater periodically

[Timer]
# First check shortly after boot, then every 15 minutes.
OnBootSec=5min
OnUnitActiveSec=15min
# Spread the load / avoid a thundering herd across multiple hosts.
RandomizedDelaySec=5min
# Catch up on a missed run if the machine was off when it was due.
Persistent=true

[Install]
WantedBy=timers.target
